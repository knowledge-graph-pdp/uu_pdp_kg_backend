    pdp:ringkasan "Masyarakat dapat berperan langsung atau tidak langsung melalui pendidikan, pelatihan, advokasi, sosialisasi, dan/atau pengawasan."@id ;
    pdp:verified false .

d:Pasal_64 a pdp:Pasal ;
    rdfs:label "Pasal 64"@id ;
    dcterms:identifier "Pasal 64" ;
    pdp:pasalNumber 64 ;
