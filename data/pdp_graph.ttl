    pdp:imposesObligation d:Norm_56_3 ;
    pdp:pasalNumber 56 ;
    pdp:referredBy d:Pasal_56_ayat_4 ;
    pdp:refersTo d:Pasal_56_ayat_2 ;
    pdp:ringkasan "Jika ayat (2) tidak terpenuhi, Pengendali wajib memastikan pelindungan yang memadai dan bersifat mengikat."@id ;
