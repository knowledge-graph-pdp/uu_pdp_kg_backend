    pdp:grantsRight d:Norm_6_0 ;
    pdp:pasalNumber 6 ;
    pdp:ringkasan "Hak melengkapi, memperbarui, dan/atau memperbaiki kesalahan data tentang dirinya sesuai tujuan pemrosesan."@id ;
    pdp:verified false .

d:Pasal_60 a pdp:Pasal ;
    rdfs:label "Pasal 60"@id ;
    dcterms:identifier "Pasal 60" ;
    pdp:pasalNumber 60 ;
    pdp:ringkasan "Kewenangan lembaga antara lain menetapkan kebijakan, mengawasi, menjatuhkan sanksi administratif, menerima aduan, memanggil pihak, dan memeriksa sistem elektronik."@id ;
    pdp:verified false .

d:Pasal_61 a pdp:Pasal ;
    rdfs:label "Pasal 61"@id ;
    dcterms:identifier "Pasal 61" ;
    pdp:pasalNumber 61 ;
    pdp:ringkasan "Tata cara pelaksanaan kewenangan lembaga diatur dengan Peraturan Pemerintah."@id ;
    pdp:verified false .

d:Pasal_62 a pdp:Pasal ;
    rdfs:label "Pasal 62"@id ;
    dcterms:identifier "Pasal 62" ;
    pdp:pasalNumber 62 ;
    pdp:ringkasan "Pemerintah melakukan kerja sama internasional sesuai peraturan perundang-undangan dan prinsip hukum internasional."@id ;
    pdp:verified false .

d:Pasal_63 a pdp:Pasal ;
    rdfs:label "Pasal 63"@id ;
    dcterms:identifier "Pasal 63" ;
