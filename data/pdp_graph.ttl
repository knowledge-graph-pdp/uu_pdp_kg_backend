d:Deadline_2_tahun a pdp:Deadline ;
    rdfs:label "2 tahun"@id .

d:Norm_12_1 a pdp:Hak ;
    rdfs:label "Hak pada Pasal 12 ayat (1)"@id ;
    pdp:appliesTo d:SubjekDataPribadi ;
    pdp:ringkasan "Hak menggugat dan menerima ganti rugi atas pelanggaran pemrosesan data tentang dirinya."@id .

d:Norm_20_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 20 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib memiliki dasar pemrosesan Data Pribadi."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_21_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 21 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Berdasarkan persetujuan, Pengendali wajib menyampaikan informasi legalitas, tujuan, jenis dan relevansi data, jangka waktu retensi dokumen, rincian data, jangka waktu pemrosesan, dan hak Subjek Data."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_21_2 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 21 ayat (2)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib memberitahukan Subjek Data atas perubahan informasi sebelum perubahan berlaku."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_22_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 22 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Persetujuan pemrosesan dilakukan melalui persetujuan tertulis atau terekam, secara elektronik atau nonelektronik."@id .

d:Norm_22_4 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 22 ayat (4)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Jika persetujuan memuat tujuan lain, permintaan harus dapat dibedakan secara jelas, dalam format yang dapat dipahami dan diakses, dengan bahasa sederhana dan jelas."@id .

d:Norm_24_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 24"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib menunjukkan bukti persetujuan yang telah diberikan Subjek Data."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_25_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 25 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:concernsData d:DataAnak ;
    pdp:ringkasan "Pemrosesan data anak diselenggarakan secara khusus."@id .

d:Norm_26_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 26 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pemrosesan data penyandang disabilitas diselenggarakan secara khusus."@id .

d:Norm_27_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 27"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib melakukan pemrosesan secara terbatas dan spesifik, sah secara hukum, dan transparan."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_28_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 28"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib melakukan pemrosesan sesuai tujuan pemrosesan."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_29_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 29"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib memastikan akurasi, kelengkapan, dan konsistensi data dengan melakukan verifikasi."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_30_2 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 30 ayat (2)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib memberitahukan hasil pembaruan atau perbaikan kepada Subjek Data."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_31_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 31"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib merekam seluruh kegiatan pemrosesan data."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_32_2 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 32 ayat (2)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:hasDeadline d:Deadline_3x24_jam ;
    pdp:ringkasan "Akses diberikan paling lambat 3x24 jam sejak permintaan diterima."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_33_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 33"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib menolak permintaan akses atau perubahan jika membahayakan keamanan atau kesehatan fisik dan mental, mengungkap data orang lain, atau bertentangan dengan pertahanan dan keamanan nasional."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_34_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 34 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib melakukan penilaian dampak pelindungan data pribadi untuk pemrosesan berisiko tinggi."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_35_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 35"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib melindungi dan memastikan keamanan data dengan langkah teknis operasional dan penetapan tingkat keamanan sesuai sifat dan risiko data."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_37_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 37"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib melakukan pengawasan terhadap setiap pihak yang terlibat dalam pemrosesan di bawah kendalinya."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_38_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 38"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib melindungi data dari pemrosesan yang tidak sah."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_39_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 39 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib mencegah data diakses secara tidak sah."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_40_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 40 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib menghentikan pemrosesan jika Subjek Data menarik persetujuan."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_40_2 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 40 ayat (2)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:hasDeadline d:Deadline_3x24_jam ;
    pdp:ringkasan "Penghentian dilakukan paling lambat 3x24 jam sejak permintaan penarikan persetujuan diterima."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_41_3 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 41 ayat (3)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib memberitahukan Subjek Data setelah penundaan atau pembatasan berlaku."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_46_3 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 46 ayat (3)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Dalam hal tertentu, Pengendali wajib memberitahukan kepada masyarakat mengenai kegagalan pelindungan data pribadi."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_47_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 47"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib bertanggung jawab atas pemrosesan dan menunjukkan pertanggungjawabannya dalam memenuhi prinsip pelindungan data pribadi."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_48_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 48 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali berbentuk badan hukum yang melakukan penggabungan, pemisahan, pengambilalihan, peleburan, atau pembubaran wajib menyampaikan pemberitahuan pengalihan data kepada Subjek Data."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_49_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 49"@id ;
    pdp:appliesTo d:PengendaliDataPribadi,
        d:ProsesorDataPribadi ;
    pdp:ringkasan "Pengendali dan/atau Prosesor wajib mematuhi perintah lembaga dalam rangka penyelenggaraan undang-undang ini."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_51_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 51 ayat (1)"@id ;
    pdp:appliesTo d:ProsesorDataPribadi ;
    pdp:ringkasan "Prosesor wajib melakukan pemrosesan berdasarkan perintah Pengendali."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_51_5 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 51 ayat (5)"@id ;
    pdp:appliesTo d:ProsesorDataPribadi ;
    pdp:ringkasan "Prosesor wajib memperoleh persetujuan tertulis Pengendali sebelum melibatkan Prosesor lain."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_52_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 52"@id ;
    pdp:appliesTo d:ProsesorDataPribadi ;
    pdp:ringkasan "Kewajiban Pengendali pada Pasal 29, 31, 35, 36, 37, 38, dan 39 berlaku juga bagi Prosesor."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_53_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 53 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi,
        d:ProsesorDataPribadi ;
    pdp:concernsData d:DataPribadiSpesifik ;
    pdp:ringkasan "Pengendali dan Prosesor wajib menunjuk pejabat pelindungan data pribadi jika untuk pelayanan publik, kegiatan inti berupa pemantauan sistematis skala besar, atau kegiatan inti pemrosesan data spesifik dan/atau tindak pidana skala besar."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_54_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 54 ayat (1)"@id ;
    pdp:appliesTo d:PejabatPelindungDataPribadi ;
    pdp:ringkasan "Pejabat pelindungan data pribadi paling sedikit menginformasikan dan memberi saran kepatuhan, memantau kepatuhan, memberi saran penilaian dampak, serta berkoordinasi dan menjadi narahubung."@id .

d:Norm_55_2 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 55 ayat (2)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali pengirim dan penerima di wilayah Indonesia wajib melakukan pelindungan data sesuai undang-undang ini."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_56_2 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 56 ayat (2)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Pengendali wajib memastikan negara tujuan transfer memiliki tingkat pelindungan setara atau lebih tinggi."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_56_3 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 56 ayat (3)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Jika ayat (2) tidak terpenuhi, Pengendali wajib memastikan pelindungan yang memadai dan bersifat mengikat."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_56_4 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 56 ayat (4)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:ringkasan "Jika ayat (2) dan (3) tidak terpenuhi, Pengendali wajib memperoleh persetujuan Subjek Data."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_5_0 a pdp:Hak ;
    rdfs:label "Hak pada Pasal 5"@id ;
    pdp:appliesTo d:SubjekDataPribadi ;
    pdp:ringkasan "Hak mendapatkan informasi tentang kejelasan identitas, dasar kepentingan hukum, tujuan permintaan dan penggunaan data, serta akuntabilitas pihak yang meminta."@id .

d:Norm_65_1 a pdp:Larangan ;
    rdfs:label "Larangan pada Pasal 65 ayat (1)"@id ;
    pdp:appliesTo d:SetiapOrang ;
    pdp:ringkasan "Dilarang secara melawan hukum memperoleh atau mengumpulkan data milik orang lain untuk menguntungkan diri sendiri atau orang lain yang dapat mengakibatkan kerugian Subjek Data."@id ;
    pdp:sanctionedBy d:Norm_67_1,
        d:Norm_69_0 .

d:Norm_65_2 a pdp:Larangan ;
    rdfs:label "Larangan pada Pasal 65 ayat (2)"@id ;
    pdp:appliesTo d:SetiapOrang ;
    pdp:ringkasan "Dilarang secara melawan hukum mengungkapkan data milik orang lain."@id ;
    pdp:sanctionedBy d:Norm_67_2,
        d:Norm_69_0 .

d:Norm_65_3 a pdp:Larangan ;
    rdfs:label "Larangan pada Pasal 65 ayat (3)"@id ;
    pdp:appliesTo d:SetiapOrang ;
