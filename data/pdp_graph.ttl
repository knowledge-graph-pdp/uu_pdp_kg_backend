    pdp:pasalNumber 10 ;
    pdp:referredBy d:Pasal_15_ayat_1 ;
    pdp:ringkasan "Hak mengajukan keberatan atas keputusan yang hanya didasarkan pada pemrosesan otomatis, termasuk pemrofilan, yang menimbulkan akibat hukum atau dampak signifikan."@id ;
    pdp:verified false .

d:Pasal_11 a pdp:Pasal ;
    rdfs:label "Pasal 11"@id ;
    dcterms:identifier "Pasal 11" ;
    pdp:grantsRight d:Norm_11_0 ;
    pdp:pasalNumber 11 ;
    pdp:referredBy d:Pasal_15_ayat_1 ;
    pdp:ringkasan "Hak menunda atau membatasi pemrosesan data secara proporsional sesuai tujuan pemrosesan."@id ;
    pdp:verified false .

d:Pasal_13_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 13 ayat (1)"@id ;
    pdp:grantsRight d:Norm_13_1 ;
    pdp:pasalNumber 13 ;
    pdp:referredBy d:Pasal_15_ayat_1 ;
    pdp:ringkasan "Hak memperoleh dan/atau menggunakan data tentang dirinya dalam bentuk yang sesuai struktur dan format lazim, serta mengirimkannya ke Pengendali lain (portabilitas)."@id ;
    pdp:verified false .

d:Pasal_20_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 20 ayat (1)"@id ;
    pdp:imposesObligation d:Norm_20_1 ;
    pdp:pasalNumber 20 ;
    pdp:referredBy d:Pasal_57_ayat_1 ;
    pdp:ringkasan "Pengendali wajib memiliki dasar pemrosesan Data Pribadi."@id ;
    pdp:verified false .

d:Pasal_20_ayat_2 a pdp:Ayat ;
    rdfs:label "Pasal 20 ayat (2)"@id ;
    pdp:hasPart d:Pasal_20_ayat_2_huruf_a,
        d:Pasal_20_ayat_2_huruf_b,
        d:Pasal_20_ayat_2_huruf_c,
        d:Pasal_20_ayat_2_huruf_d,
        d:Pasal_20_ayat_2_huruf_e,
        d:Pasal_20_ayat_2_huruf_f ;
    pdp:pasalNumber 20 ;
    pdp:referredBy d:Pasal_21_ayat_1 ;
    pdp:ringkasan "Dasar pemrosesan: persetujuan eksplisit yang sah, pemenuhan perjanjian, kewajiban hukum, pelindungan kepentingan vital, tugas kepentingan umum atau kewenangan, dan kepentingan yang sah lainnya."@id ;
    pdp:verified false .

d:Pasal_21_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 21 ayat (1)"@id ;
    pdp:hasPart d:Pasal_21_ayat_1_huruf_a,
        d:Pasal_21_ayat_1_huruf_b,
        d:Pasal_21_ayat_1_huruf_c,
        d:Pasal_21_ayat_1_huruf_d,
        d:Pasal_21_ayat_1_huruf_e,
        d:Pasal_21_ayat_1_huruf_f,
        d:Pasal_21_ayat_1_huruf_g ;
    pdp:imposesObligation d:Norm_21_1 ;
    pdp:pasalNumber 21 ;
    pdp:refersTo d:Pasal_20_ayat_2 ;
    pdp:ringkasan "Berdasarkan persetujuan, Pengendali wajib menyampaikan informasi legalitas, tujuan, jenis dan relevansi data, jangka waktu retensi dokumen, rincian data, jangka waktu pemrosesan, dan hak Subjek Data."@id ;
    pdp:verified false .

d:Pasal_22_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 22 ayat (1)"@id ;
    pdp:imposesObligation d:Norm_22_1 ;
    pdp:pasalNumber 22 ;
    pdp:referredBy d:Pasal_22_ayat_5 ;
    pdp:ringkasan "Persetujuan pemrosesan dilakukan melalui persetujuan tertulis atau terekam, secara elektronik atau nonelektronik."@id ;
    pdp:verified false .

d:Pasal_22_ayat_4 a pdp:Ayat ;
    rdfs:label "Pasal 22 ayat (4)"@id ;
    pdp:imposesObligation d:Norm_22_4 ;
    pdp:pasalNumber 22 ;
    pdp:referredBy d:Pasal_22_ayat_5 ;
    pdp:ringkasan "Jika persetujuan memuat tujuan lain, permintaan harus dapat dibedakan secara jelas, dalam format yang dapat dipahami dan diakses, dengan bahasa sederhana dan jelas."@id ;
    pdp:verified false .

d:Pasal_29 a pdp:Pasal ;
    rdfs:label "Pasal 29"@id ;
    dcterms:identifier "Pasal 29" ;
    pdp:imposesObligation d:Norm_29_0 ;
    pdp:pasalNumber 29 ;
    pdp:referredBy d:Pasal_52 ;
