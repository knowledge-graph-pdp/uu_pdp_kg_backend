d:Pasal_70_ayat_2 a pdp:Ayat ;
    rdfs:label "Pasal 70 ayat (2)"@id ;
    pdp:establishesNorm d:Norm_70_2 ;
    pdp:pasalNumber 70 ;
    pdp:ringkasan "Korporasi hanya dapat dijatuhi pidana denda."@id ;
    pdp:verified false .

d:Pasal_70_ayat_3 a pdp:Ayat ;
    rdfs:label "Pasal 70 ayat (3)"@id ;
    pdp:establishesNorm d:Norm_70_3 ;
    pdp:pasalNumber 70 ;
    pdp:ringkasan "Pidana denda yang dijatuhkan kepada korporasi paling banyak 10 kali dari maksimum pidana denda yang diancamkan."@id ;
    pdp:verified false .

d:Pasal_70_ayat_4 a pdp:Ayat ;
    rdfs:label "Pasal 70 ayat (4)"@id ;
    pdp:establishesNorm d:Norm_70_4 ;
    pdp:hasPart d:Pasal_70_ayat_4_huruf_a,
        d:Pasal_70_ayat_4_huruf_b,
        d:Pasal_70_ayat_4_huruf_c,
        d:Pasal_70_ayat_4_huruf_d,
        d:Pasal_70_ayat_4_huruf_e,
        d:Pasal_70_ayat_4_huruf_f,
        d:Pasal_70_ayat_4_huruf_g,
        d:Pasal_70_ayat_4_huruf_h ;
    pdp:pasalNumber 70 ;
    pdp:ringkasan "Korporasi dapat dijatuhi pidana tambahan berupa perampasan keuntungan, pembekuan usaha, pelarangan permanen, penutupan tempat usaha, pelaksanaan kewajiban yang dilalaikan, ganti kerugian, pencabutan izin, dan/atau pembubaran."@id ;
    pdp:verified false .

d:Pasal_70_ayat_4_huruf_a a pdp:Huruf ;
    rdfs:label "Pasal 70 ayat (4) huruf a"@id ;
    pdp:letter "a" ;
    pdp:position 1 ;
    pdp:ringkasan "perampasan keuntungan atau harta kekayaan hasil tindak pidana"@id ;
    pdp:verified false .

d:Pasal_70_ayat_4_huruf_b a pdp:Huruf ;
    rdfs:label "Pasal 70 ayat (4) huruf b"@id ;
    pdp:letter "b" ;
    pdp:position 2 ;
    pdp:ringkasan "pembekuan seluruh atau sebagian usaha korporasi"@id ;
    pdp:verified false .

d:Pasal_70_ayat_4_huruf_c a pdp:Huruf ;
    rdfs:label "Pasal 70 ayat (4) huruf c"@id ;
    pdp:letter "c" ;
    pdp:position 3 ;
    pdp:ringkasan "pelarangan tetap melakukan perbuatan tertentu"@id ;
    pdp:verified false .

d:Pasal_70_ayat_4_huruf_d a pdp:Huruf ;
    rdfs:label "Pasal 70 ayat (4) huruf d"@id ;
    pdp:letter "d" ;
    pdp:position 4 ;
    pdp:ringkasan "penutupan seluruh atau sebagian tempat usaha"@id ;
    pdp:verified false .

d:Pasal_70_ayat_4_huruf_e a pdp:Huruf ;
    rdfs:label "Pasal 70 ayat (4) huruf e"@id ;
    pdp:letter "e" ;
    pdp:position 5 ;
    pdp:ringkasan "pelaksanaan kewajiban yang telah dilalaikan"@id ;
    pdp:verified false .

d:Pasal_70_ayat_4_huruf_f a pdp:Huruf ;
    rdfs:label "Pasal 70 ayat (4) huruf f"@id ;
    pdp:letter "f" ;
    pdp:position 6 ;
    pdp:ringkasan "pembayaran ganti kerugian"@id ;
    pdp:verified false .

d:Pasal_70_ayat_4_huruf_g a pdp:Huruf ;
    rdfs:label "Pasal 70 ayat (4) huruf g"@id ;
    pdp:letter "g" ;
    pdp:position 7 ;
    pdp:ringkasan "pencabutan izin"@id ;
    pdp:verified false .

