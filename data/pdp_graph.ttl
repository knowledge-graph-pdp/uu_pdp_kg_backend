    pdp:letter "h" ;
    pdp:position 8 ;
    pdp:ringkasan "pembubaran korporasi"@id ;
    pdp:verified false .

d:Pasal_74 a pdp:Pasal ;
    rdfs:label "Pasal 74"@id ;
    dcterms:identifier "Pasal 74" ;
    pdp:imposesObligation d:Norm_74_0 ;
    pdp:pasalNumber 74 ;
    pdp:ringkasan "Pengendali, Prosesor, dan pihak terkait wajib menyesuaikan dengan ketentuan pemrosesan paling lama 2 tahun sejak undang-undang diundangkan."@id ;
    pdp:verified false .

d:Pasal_75 a pdp:Pasal ;
    rdfs:label "Pasal 75"@id ;
    dcterms:identifier "Pasal 75" ;
    pdp:pasalNumber 75 ;
    pdp:ringkasan "Peraturan yang sudah ada tentang pelindungan data pribadi tetap berlaku sepanjang tidak bertentangan dengan undang-undang ini."@id ;
    pdp:verified false .

d:Pasal_76 a pdp:Pasal ;
    rdfs:label "Pasal 76"@id ;
    dcterms:identifier "Pasal 76" ;
    pdp:pasalNumber 76 ;
    pdp:ringkasan "Undang-undang berlaku pada tanggal diundangkan, 17 Oktober 2022 (LN 2022 No. 196)."@id ;
    pdp:verified false .

d:PejabatPelindungDataPribadi a pdp:Actor ;
    rdfs:label "Pejabat atau Petugas Pelindungan Data Pribadi"@id .

pdp:LegalDocument a owl:Class .

pdp:hasException a owl:ObjectProperty .

pdp:hasPart a owl:ObjectProperty,
        owl:TransitiveProperty .

pdp:refersTo a owl:ObjectProperty,
        owl:TransitiveProperty .

d:LembagaPengawas a pdp:Actor ;
    rdfs:label "Lembaga Pengawas"@id .

d:Norm_10_1 a pdp:Hak ;
    rdfs:label "Hak pada Pasal 10 ayat (1)"@id ;
    pdp:appliesTo d:SubjekDataPribadi ;
    pdp:hasException d:Pasal_15_ayat_1 ;
    pdp:ringkasan "Hak mengajukan keberatan atas keputusan yang hanya didasarkan pada pemrosesan otomatis, termasuk pemrofilan, yang menimbulkan akibat hukum atau dampak signifikan."@id .

d:Norm_11_0 a pdp:Hak ;
    rdfs:label "Hak pada Pasal 11"@id ;
    pdp:appliesTo d:SubjekDataPribadi ;
    pdp:hasException d:Pasal_15_ayat_1 ;
    pdp:ringkasan "Hak menunda atau membatasi pemrosesan data secara proporsional sesuai tujuan pemrosesan."@id .

d:Norm_13_1 a pdp:Hak ;
    rdfs:label "Hak pada Pasal 13 ayat (1)"@id ;
    pdp:appliesTo d:SubjekDataPribadi ;
    pdp:hasException d:Pasal_15_ayat_1 ;
    pdp:ringkasan "Hak memperoleh dan/atau menggunakan data tentang dirinya dalam bentuk yang sesuai struktur dan format lazim, serta mengirimkannya ke Pengendali lain (portabilitas)."@id .

d:Norm_36_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 36"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:hasException d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Pengendali wajib menjaga kerahasiaan data."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_41_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 41 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:hasDeadline d:Deadline_3x24_jam ;
    pdp:hasException d:Pasal_41_ayat_2 ;
    pdp:ringkasan "Pengendali wajib melakukan penundaan dan pembatasan pemrosesan, sebagian atau seluruhnya, paling lambat 3x24 jam sejak permintaan."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_42_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 42 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:hasException d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Pengendali wajib mengakhiri pemrosesan jika masa retensi berakhir, tujuan tercapai, atau ada permintaan Subjek Data."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_43_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 43 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:hasException d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Pengendali wajib menghapus data jika tidak lagi diperlukan, persetujuan ditarik, ada permintaan Subjek Data, atau data diperoleh dan diproses secara melawan hukum."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_44_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 44 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:hasException d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Pengendali wajib memusnahkan data jika masa retensi berakhir dan jadwal retensi arsip menentukan musnah, ada permintaan Subjek Data, tidak berkaitan perkara hukum, atau diperoleh secara melawan hukum."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_45_0 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 45"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:hasException d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Pengendali wajib memberitahukan Subjek Data atas penghapusan dan/atau pemusnahan data."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

d:Norm_46_1 a pdp:Kewajiban ;
    rdfs:label "Kewajiban pada Pasal 46 ayat (1)"@id ;
    pdp:appliesTo d:PengendaliDataPribadi ;
    pdp:hasDeadline d:Deadline_3x24_jam ;
    pdp:hasException d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Dalam hal terjadi kegagalan pelindungan data pribadi, Pengendali wajib menyampaikan pemberitahuan tertulis paling lambat 3x24 jam kepada Subjek Data dan lembaga."@id ;
    pdp:sanctionedBy d:Norm_57_2,
        d:Norm_57_3 .

