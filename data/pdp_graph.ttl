    dcterms:identifier "Pasal 31" ;
    pdp:imposesObligation d:Norm_31_0 ;
    pdp:pasalNumber 31 ;
    pdp:referredBy d:Pasal_52 ;
    pdp:ringkasan "Pengendali wajib merekam seluruh kegiatan pemrosesan data."@id ;
    pdp:verified false .

d:Pasal_32 a pdp:Pasal ;
    rdfs:label "Pasal 32"@id ;
    dcterms:identifier "Pasal 32" ;
    pdp:hasPart d:Pasal_32_ayat_1,
        d:Pasal_32_ayat_2 ;
    pdp:referredBy d:Pasal_50_ayat_1 .

d:Pasal_35 a pdp:Pasal ;
    rdfs:label "Pasal 35"@id ;
    dcterms:identifier "Pasal 35" ;
    pdp:imposesObligation d:Norm_35_0 ;
    pdp:pasalNumber 35 ;
    pdp:referredBy d:Pasal_52 ;
    pdp:ringkasan "Pengendali wajib melindungi dan memastikan keamanan data dengan langkah teknis operasional dan penetapan tingkat keamanan sesuai sifat dan risiko data."@id ;
    pdp:verified false .

d:Pasal_37 a pdp:Pasal ;
    rdfs:label "Pasal 37"@id ;
    dcterms:identifier "Pasal 37" ;
    pdp:imposesObligation d:Norm_37_0 ;
    pdp:pasalNumber 37 ;
    pdp:referredBy d:Pasal_52 ;
    pdp:ringkasan "Pengendali wajib melakukan pengawasan terhadap setiap pihak yang terlibat dalam pemrosesan di bawah kendalinya."@id ;
    pdp:verified false .

d:Pasal_38 a pdp:Pasal ;
    rdfs:label "Pasal 38"@id ;
    dcterms:identifier "Pasal 38" ;
    pdp:imposesObligation d:Norm_38_0 ;
    pdp:pasalNumber 38 ;
    pdp:referredBy d:Pasal_52 ;
    pdp:ringkasan "Pengendali wajib melindungi data dari pemrosesan yang tidak sah."@id ;
    pdp:verified false .

d:Pasal_39_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 39 ayat (1)"@id ;
    pdp:imposesObligation d:Norm_39_1 ;
    pdp:pasalNumber 39 ;
    pdp:referredBy d:Pasal_52 ;
    pdp:ringkasan "Pengendali wajib mencegah data diakses secara tidak sah."@id ;
    pdp:verified false .

d:Pasal_41_ayat_2 a pdp:Ayat ;
    rdfs:label "Pasal 41 ayat (2)"@id ;
    pdp:hasPart d:Pasal_41_ayat_2_huruf_a,
        d:Pasal_41_ayat_2_huruf_b,
        d:Pasal_41_ayat_2_huruf_c ;
    pdp:isExceptionFor d:Norm_41_1 ;
    pdp:pasalNumber 41 ;
    pdp:ringkasan "Pengecualian: tidak diizinkan undang-undang, dapat membahayakan pihak lain, atau Subjek Data memiliki perjanjian tertulis yang tidak mengizinkan."@id ;
    pdp:verified false .

d:Pasal_42_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 42 ayat (1)"@id ;
    pdp:hasPart d:Pasal_42_ayat_1_huruf_a,
        d:Pasal_42_ayat_1_huruf_b,
        d:Pasal_42_ayat_1_huruf_c ;
    pdp:imposesObligation d:Norm_42_1 ;
    pdp:pasalNumber 42 ;
    pdp:referredBy d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Pengendali wajib mengakhiri pemrosesan jika masa retensi berakhir, tujuan tercapai, atau ada permintaan Subjek Data."@id ;
    pdp:verified false .

d:Pasal_43_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 43 ayat (1)"@id ;
    pdp:hasPart d:Pasal_43_ayat_1_huruf_a,
        d:Pasal_43_ayat_1_huruf_b,
        d:Pasal_43_ayat_1_huruf_c,
        d:Pasal_43_ayat_1_huruf_d ;
    pdp:imposesObligation d:Norm_43_1 ;
    pdp:pasalNumber 43 ;
    pdp:referredBy d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Pengendali wajib menghapus data jika tidak lagi diperlukan, persetujuan ditarik, ada permintaan Subjek Data, atau data diperoleh dan diproses secara melawan hukum."@id ;
    pdp:verified false .

d:Pasal_44_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 44 ayat (1)"@id ;
    pdp:hasPart d:Pasal_44_ayat_1_huruf_a,
        d:Pasal_44_ayat_1_huruf_b,
        d:Pasal_44_ayat_1_huruf_c,
        d:Pasal_44_ayat_1_huruf_d ;
    pdp:imposesObligation d:Norm_44_1 ;
    pdp:pasalNumber 44 ;
    pdp:referredBy d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Pengendali wajib memusnahkan data jika masa retensi berakhir dan jadwal retensi arsip menentukan musnah, ada permintaan Subjek Data, tidak berkaitan perkara hukum, atau diperoleh secara melawan hukum."@id ;
    pdp:verified false .

d:Pasal_45 a pdp:Pasal ;
    rdfs:label "Pasal 45"@id ;
    dcterms:identifier "Pasal 45" ;
    pdp:imposesObligation d:Norm_45_0 ;
    pdp:pasalNumber 45 ;
    pdp:referredBy d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Pengendali wajib memberitahukan Subjek Data atas penghapusan dan/atau pemusnahan data."@id ;
    pdp:verified false .

d:Pasal_46_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 46 ayat (1)"@id ;
    pdp:imposesObligation d:Norm_46_1 ;
    pdp:pasalNumber 46 ;
    pdp:referredBy d:Pasal_50_ayat_1 ;
    pdp:ringkasan "Dalam hal terjadi kegagalan pelindungan data pribadi, Pengendali wajib menyampaikan pemberitahuan tertulis paling lambat 3x24 jam kepada Subjek Data dan lembaga."@id ;
    pdp:verified false .

d:Pasal_57_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 57 ayat (1)"@id ;
    pdp:pasalNumber 57 ;
    pdp:refersTo d:Pasal_20_ayat_1 ;
    pdp:ringkasan "Pelanggaran atas pasal-pasal tertentu dapat dikenai sanksi administratif."@id ;
    pdp:verified false .

d:Pasal_58 a pdp:Pasal ;
    rdfs:label "Pasal 58"@id ;
    dcterms:identifier "Pasal 58" ;
    pdp:pasalNumber 58 ;
    pdp:ringkasan "Pemerintah mewujudkan pelindungan data pribadi melalui lembaga yang ditetapkan Presiden dan bertanggung jawab kepada Presiden."@id ;
    pdp:verified false .

d:Pasal_65_ayat_1 a pdp:Ayat ;
    rdfs:label "Pasal 65 ayat (1)"@id ;
    pdp:imposesProhibition d:Norm_65_1 ;
    pdp:pasalNumber 65 ;
    pdp:referredBy d:Pasal_67_ayat_1 ;
    pdp:ringkasan "Dilarang secara melawan hukum memperoleh atau mengumpulkan data milik orang lain untuk menguntungkan diri sendiri atau orang lain yang dapat mengakibatkan kerugian Subjek Data."@id ;
    pdp:verified false .

d:Pasal_65_ayat_2 a pdp:Ayat ;
    rdfs:label "Pasal 65 ayat (2)"@id ;
    pdp:imposesProhibition d:Norm_65_2 ;
    pdp:pasalNumber 65 ;
    pdp:referredBy d:Pasal_67_ayat_2 ;
    pdp:ringkasan "Dilarang secara melawan hukum mengungkapkan data milik orang lain."@id ;
    pdp:verified false .

d:Pasal_65_ayat_3 a pdp:Ayat ;
    rdfs:label "Pasal 65 ayat (3)"@id ;
    pdp:imposesProhibition d:Norm_65_3 ;
    pdp:pasalNumber 65 ;
    pdp:referredBy d:Pasal_67_ayat_3 ;
    pdp:ringkasan "Dilarang secara melawan hukum menggunakan data milik orang lain."@id ;
    pdp:verified false .

d:Pasal_66 a pdp:Pasal ;
    rdfs:label "Pasal 66"@id ;
    dcterms:identifier "Pasal 66" ;
    pdp:imposesProhibition d:Norm_66_0 ;
    pdp:pasalNumber 66 ;
    pdp:referredBy d:Pasal_68 ;
    pdp:ringkasan "Dilarang membuat data palsu atau memalsukan data untuk menguntungkan diri sendiri atau orang lain yang dapat merugikan orang lain."@id ;
    pdp:verified false .

d:Pasal_71 a pdp:Pasal ;
    rdfs:label "Pasal 71"@id ;
    dcterms:identifier "Pasal 71" ;
    pdp:pasalNumber 71 ;
    pdp:referredBy d:Pasal_73 ;
    pdp:ringkasan "Terpidana diberi waktu 1 bulan sejak putusan berkekuatan hukum tetap untuk membayar denda; harta dapat disita dan dilelang, dan jika tidak cukup diganti pidana penjara."@id ;
    pdp:verified false .

d:Pasal_72 a pdp:Pasal ;
    rdfs:label "Pasal 72"@id ;
    dcterms:identifier "Pasal 72" ;
    pdp:pasalNumber 72 ;
    pdp:referredBy d:Pasal_73 ;
    pdp:ringkasan "Jika penyitaan harta korporasi tidak cukup melunasi denda, korporasi dikenai pembekuan sebagian atau seluruh usaha paling lama 5 tahun."@id ;
    pdp:verified false .

d:Pasal_8 a pdp:Pasal ;
    rdfs:label "Pasal 8"@id ;
    dcterms:identifier "Pasal 8" ;
    pdp:grantsRight d:Norm_8_0 ;
    pdp:pasalNumber 8 ;
    pdp:referredBy d:Pasal_15_ayat_1 ;
    pdp:ringkasan "Hak mengakhiri pemrosesan, menghapus, dan/atau memusnahkan data tentang dirinya."@id ;
    pdp:verified false .

d:Pasal_9 a pdp:Pasal ;
    rdfs:label "Pasal 9"@id ;
    dcterms:identifier "Pasal 9" ;
    pdp:grantsRight d:Norm_9_0 ;
    pdp:pasalNumber 9 ;
    pdp:referredBy d:Pasal_15_ayat_1 ;
    pdp:ringkasan "Hak menarik kembali persetujuan pemrosesan data yang telah diberikan."@id ;
    pdp:verified false .

