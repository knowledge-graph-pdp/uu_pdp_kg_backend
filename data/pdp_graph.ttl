    pdp:ringkasan "Tugas lembaga: merumuskan kebijakan, mengawasi, menegakkan hukum administratif, dan memfasilitasi penyelesaian sengketa di luar pengadilan."@id ;
    pdp:verified false .

d:Pasal_6 a pdp:Pasal ;
    rdfs:label "Pasal 6"@id ;
