d:Concept_DataPribadi a pdp:Concept ;
    skos:prefLabel "Data Pribadi"@id ;
    pdp:definedIn d:Pasal_1 .

d:Concept_Lembaga a pdp:Concept ;
    skos:prefLabel "Lembaga penyelenggara pelindungan data pribadi"@id ;
    pdp:definedIn d:Pasal_58 .

d:Concept_PelindunganDataPribadi a pdp:Concept ;
    skos:prefLabel "Pelindungan Data Pribadi"@id ;
    pdp:definedIn d:Pasal_1 .

d:Concept_PengendaliDataPribadi a pdp:Concept ;
    skos:prefLabel "Pengendali Data Pribadi"@id ;
    pdp:definedIn d:Pasal_1 .

d:Concept_ProsesorDataPribadi a pdp:Concept ;
    skos:prefLabel "Prosesor Data Pribadi"@id ;
    pdp:definedIn d:Pasal_1 .

d:Concept_SubjekDataPribadi a pdp:Concept ;
    skos:prefLabel "Subjek Data Pribadi"@id ;
    pdp:definedIn d:Pasal_1 .

d:Pemerintah a pdp:Actor ;
    rdfs:label "Pemerintah"@id .

d:UU_27_2022 a pdp:LegalDocument ;
    dcterms:identifier "LN 2022 No. 196, TLN No. 6820" ;
    dcterms:issued "2022-10-17"^^xsd:date ;
    dcterms:title "Undang-Undang Nomor 27 Tahun 2022 tentang Pelindungan Data Pribadi"@id ;
    pdp:hasPart d:Bab_I,
        d:Bab_II,
        d:Bab_III,
        d:Bab_IV,
        d:Bab_IX,
        d:Bab_V,
        d:Bab_VI,
        d:Bab_VII,
        d:Bab_VIII,
        d:Bab_X,
        d:Bab_XI,
        d:Bab_XII,
        d:Bab_XIII,
        d:Bab_XIV,
        d:Bab_XV,
        d:Bab_XVI .

pdp:appliesTo a owl:ObjectProperty .

pdp:concernsData a owl:ObjectProperty .

pdp:definedIn a owl:ObjectProperty .

pdp:grantsRight a owl:ObjectProperty ;
    rdfs:subPropertyOf pdp:establishesNorm .

pdp:hasDeadline a owl:ObjectProperty .

pdp:imposesObligation a owl:ObjectProperty ;
    rdfs:subPropertyOf pdp:establishesNorm .

pdp:imposesProhibition a owl:ObjectProperty ;
    rdfs:subPropertyOf pdp:establishesNorm .

pdp:isExceptionFor a owl:ObjectProperty ;
    owl:inverseOf pdp:hasException .

pdp:partOf a owl:ObjectProperty ;
    owl:inverseOf pdp:hasPart .

pdp:referredBy a owl:ObjectProperty ;
    owl:inverseOf pdp:refersTo .

pdp:sanctionedBy a owl:ObjectProperty .

