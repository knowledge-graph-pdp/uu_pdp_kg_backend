    dcterms:identifier "Pasal 7" ;
    pdp:grantsRight d:Norm_7_0 ;
    pdp:pasalNumber 7 ;
    pdp:ringkasan "Hak mendapatkan akses dan memperoleh salinan data tentang dirinya."@id ;
    pdp:verified false .

d:Pasal_70 a pdp:Pasal ;
