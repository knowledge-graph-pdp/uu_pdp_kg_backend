    pdp:verified false .

d:Pasal_36 a pdp:Pasal ;
    rdfs:label "Pasal 36"@id ;
    dcterms:identifier "Pasal 36" ;
    pdp:imposesObligation d:Norm_36_0 ;
    pdp:pasalNumber 36 ;
    pdp:referredBy d:Pasal_50_ayat_1,
        d:Pasal_52 ;
    pdp:ringkasan "Pengendali wajib menjaga kerahasiaan data."@id ;
    pdp:verified false .

d:Pasal_56_ayat_2 a pdp:Ayat ;
    rdfs:label "Pasal 56 ayat (2)"@id ;
    pdp:imposesObligation d:Norm_56_2 ;
    pdp:pasalNumber 56 ;
    pdp:referredBy d:Pasal_56_ayat_3,
        d:Pasal_56_ayat_4 ;
    pdp:ringkasan "Pengendali wajib memastikan negara tujuan transfer memiliki tingkat pelindungan setara atau lebih tinggi."@id ;
    pdp:verified false .

d:Pasal_56_ayat_3 a pdp:Ayat ;
