d:Norm_8_0 a pdp:Hak ;
    rdfs:label "Hak pada Pasal 8"@id ;
    pdp:appliesTo d:SubjekDataPribadi ;
    pdp:hasException d:Pasal_15_ayat_1 ;
    pdp:ringkasan "Hak mengakhiri pemrosesan, menghapus, dan/atau memusnahkan data tentang dirinya."@id .

d:Norm_9_0 a pdp:Hak ;
