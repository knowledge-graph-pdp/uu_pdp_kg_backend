    skos:altLabel "prosesor"@id ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:notation "Prosesor" ;
    skos:prefLabel "Prosesor Data Pribadi"@id ;
    skos:topConceptOf d:PDP_Concept_Scheme ;
    pdp:verified false .

d:Concept_DataSpesifik a skos:Concept,
        pdp:Concept ;
    skos:altLabel "spesifik"@id ;
    skos:broader d:Concept_DataPribadi ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:narrower d:Concept_CatatanKejahatan,
        d:Concept_DataAnak,
        d:Concept_DataBiometrik,
        d:Concept_DataGenetika,
        d:Concept_DataKesehatan,
        d:Concept_DataKeuangan ;
    skos:notation "DataSpesifik" ;
    skos:prefLabel "Data Pribadi spesifik"@id ;
    pdp:verified false .

d:Concept_Tenggat a skos:Concept,
        pdp:Concept ;
    skos:altLabel "paling lama"@id,
        "paling lambat"@id ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:narrower d:Concept_Tenggat3x24 ;
    skos:notation "Tenggat" ;
    skos:prefLabel "Tenggat waktu"@id ;
    skos:topConceptOf d:PDP_Concept_Scheme ;
    pdp:verified false .

d:Concept_Persetujuan a skos:Concept,
        pdp:Concept ;
    skos:altLabel "persetujuan"@id ;
    skos:broader d:Concept_Pemrosesan ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:notation "Persetujuan" ;
    skos:prefLabel "Persetujuan"@id ;
    pdp:verified false .

d:Concept_Pelindungan a skos:Concept,
        pdp:Concept ;
    skos:altLabel "pelindungan"@id ;
    skos:broader d:Concept_Asas ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:notation "Pelindungan" ;
    skos:prefLabel "Pelindungan"@id ;
    pdp:verified false .

d:Concept_SubjekData a skos:Concept,
        pdp:Concept ;
    skos:altLabel "subjek data"@id ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:notation "SubjekData" ;
    skos:prefLabel "Subjek Data Pribadi"@id ;
    skos:topConceptOf d:PDP_Concept_Scheme ;
    pdp:verified false .

d:Concept_Sanksi a skos:Concept,
        pdp:Concept ;
    skos:altLabel "dipidana"@id,
        "pidana"@id,
        "sanksi"@id ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:narrower d:Concept_PidanaTambahan,
        d:Concept_SanksiAdministratif,
        d:Concept_SanksiPidana ;
    skos:notation "Sanksi" ;
    skos:prefLabel "Sanksi"@id ;
    skos:topConceptOf d:PDP_Concept_Scheme ;
    pdp:verified false .

d:Concept_Hak a skos:Concept,
        pdp:Concept ;
    skos:altLabel "hak"@id ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:narrower d:Concept_Akses,
        d:Concept_GantiRugi,
        d:Concept_Keberatan,
        d:Concept_PenarikanPersetujuan,
        d:Concept_Penghapusan,
        d:Concept_Perbaikan,
        d:Concept_Portabilitas ;
    skos:notation "Hak" ;
    skos:prefLabel "Hak Subjek Data"@id ;
    skos:topConceptOf d:PDP_Concept_Scheme ;
    pdp:verified false .

d:Concept_Kewajiban a skos:Concept,
        pdp:Concept ;
    skos:altLabel "wajib"@id ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:notation "Kewajiban" ;
    skos:prefLabel "Kewajiban pengendali dan prosesor"@id ;
    skos:topConceptOf d:PDP_Concept_Scheme ;
    pdp:verified false .

d:Concept_Pemrosesan a skos:Concept,
        pdp:Concept ;
    skos:altLabel "memproses"@id,
        "pemrosesan"@id ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:narrower d:Concept_DasarPemrosesan,
        d:Concept_PenilaianDampak,
        d:Concept_Persetujuan,
        d:Concept_Profiling,
        d:Concept_Retensi,
        d:Concept_TransferData ;
    skos:notation "Pemrosesan" ;
    skos:prefLabel "Pemrosesan Data Pribadi"@id ;
    skos:topConceptOf d:PDP_Concept_Scheme ;
    pdp:verified false .

d:Concept_Pengendali a skos:Concept,
        pdp:Concept ;
    skos:altLabel "pengendali"@id ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:notation "Pengendali" ;
    skos:prefLabel "Pengendali Data Pribadi"@id ;
    skos:topConceptOf d:PDP_Concept_Scheme ;
    pdp:verified false .

d:Concept_DataPribadi a skos:Concept,
        pdp:Concept ;
    skos:altLabel "data"@id,
        "data pribadi"@id ;
    skos:inScheme d:PDP_Concept_Scheme ;
    skos:narrower d:Concept_DataSpesifik,
        d:Concept_DataUmum ;
    skos:notation "DataPribadi" ;
    skos:prefLabel "Data Pribadi"@id ;
    skos:topConceptOf d:PDP_Concept_Scheme ;
    pdp:verified false .

d:PDP_Concept_Scheme a skos:ConceptScheme ;
    dcterms:title "Skema konsep UU PDP"@id ;
    skos:hasTopConcept d:Concept_Asas,
        d:Concept_BadanPublik,
        d:Concept_DataPribadi,
        d:Concept_Hak,
        d:Concept_Keamanan,
        d:Concept_KegagalanPDP,
        d:Concept_KerjaSamaInternasional,
        d:Concept_Kewajiban,
        d:Concept_Korporasi,
        d:Concept_Larangan,
        d:Concept_Lembaga,
        d:Concept_PejabatPDP,
        d:Concept_Pemberitahuan,
        d:Concept_Pembuktian,
        d:Concept_Pemrosesan,
        d:Concept_PemrosesanBersama,
        d:Concept_PengawasanVisual,
        d:Concept_Pengecualian,
        d:Concept_Pengendali,
        d:Concept_Prosesor,
        d:Concept_Sanksi,
        d:Concept_Sengketa,
        d:Concept_SetiapOrang,
        d:Concept_SubjekData,
        d:Concept_Tenggat .

pdp:Mention a owl:Class .

